# Next.js and Cloudflare Environment Configuration
# Copy this file to `.env.local` for local development overrides.

# Server Secret: Auth key sent in the authv1 header to the upstream mailing API
# Local development: set in `.env.local`
# Production: set as an encrypted Secret in Cloudflare Dashboard (Workers & Pages > Settings > Variables and Secrets)
API_KEY=

# Server & Client API URL: Target mailing API host
# Defaults to https://mail.mikatech.top in wrangler.jsonc vars
API_URL=https://mail.mikatech.top
NEXT_PUBLIC_API_URL=https://mail.mikatech.top

# Client: Delay between status indicator health checks in milliseconds
NEXT_PUBLIC_DELAY=60000

# Client: Target email recipient for contact form notifications
NEXT_PUBLIC_RECIPIENT=kendoestech01@gmail.com